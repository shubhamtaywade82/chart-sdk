# CoinDCX API credentials
# Generate keys at: https://coindcx.com/settings (API Keys section)
# NOTE: futures API keys are separate from spot keys on the CoinDCX dashboard.
# The futures secret is often shown with a "-F" suffix (e.g. "abc123-F") —
# the "-F" suffix is stripped automatically by the backend, so paste it as-is.
COINDCX_API_KEY=
COINDCX_API_SECRET=

COINDCX_FUTURES_API_KEY=
COINDCX_FUTURES_API_SECRET=

# Optional
COINDCX_DEBUG=false
COINDCX_PORT=3004