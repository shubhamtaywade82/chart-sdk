{
  "name": "chart-sdk",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./css": "./src/index.css"
  },
  "files": [
    "dist",
    "src/index.css"
  ],
  "scripts": {
    "build:package": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "dev:crypto": "tsx server/binance/index.ts & tsx server/coindcx/index.ts & VITE_APP=crypto vite --port 5200",
    "dev:binance": "npm run dev:crypto",
    "dev:dhanhq": "tsx server/dhanhq/index.ts & VITE_APP=dhanhq vite --port 5201",
    "dev:coindcx": "tsx server/coindcx/index.ts & VITE_APP=coindcx vite --port 5202",
    "dev:frontend:crypto": "VITE_APP=crypto vite --port 5200",
    "dev:frontend:binance": "VITE_APP=crypto vite --port 5200",
    "dev:frontend:dhanhq": "VITE_APP=dhanhq vite --port 5201",
    "dev:frontend:coindcx": "VITE_APP=coindcx vite --port 5202",
    "backend:crypto": "tsx server/binance/index.ts & tsx server/coindcx/index.ts",
    "backend:binance": "tsx server/binance/index.ts",
    "backend:dhanhq": "tsx server/dhanhq/index.ts",
    "backend:coindcx": "tsx server/coindcx/index.ts",
    "start:crypto": "tsx server/binance/index.ts & tsx server/coindcx/index.ts & VITE_APP=crypto vite --port 5200",
    "start:binance": "npm run start:crypto",
    "start:dhanhq": "tsx server/dhanhq/index.ts & VITE_APP=dhanhq vite --port 5201",
    "start:coindcx": "tsx server/coindcx/index.ts & VITE_APP=coindcx vite --port 5202",
    "build": "npm run build:package",
    "build:crypto": "VITE_APP=crypto tsc && VITE_APP=crypto vite build --outDir dist/crypto",
    "build:binance": "VITE_APP=crypto tsc && VITE_APP=crypto vite build --outDir dist/crypto",
    "build:dhanhq": "VITE_APP=dhanhq tsc && VITE_APP=dhanhq vite build --outDir dist/dhanhq",
    "build:coindcx": "VITE_APP=coindcx tsc && VITE_APP=coindcx vite build --outDir dist/coindcx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "axios": "^1.13.6",
    "coindcx-client-js": "github:shubhamtaywade82/coindcx-client-js",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.477.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  },
  "peerDependencies": {
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.477.0 || ^0.525.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
